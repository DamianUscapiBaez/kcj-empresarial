generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GERENCIA
  OPERACIONES
  JEFE_OPERACIONES
  SSOMA
  MANTENIMIENTO
  RRHH
  SALUD
  HOMOLOGACION
  INSTRUCTOR
  ALMACEN
  CONDUCTOR
  PROPIETARIO
}
enum CaseStatus {
  ABIERTO
  EN_ACCION
  VERIFICADO
  CERRADO
}
enum ActionStatus {
  PENDIENTE
  EJECUTADA
  VERIFICADA
}
enum WorkStatus {
  ABIERTA
  EN_PROCESO
  LIBERADA
}
enum RosterStatus {
  BORRADOR
  PUBLICADO
}
enum RosterKind {
  GUARDIA
  DESCANSO
}
enum ServiceStatus {
  PLANIFICADO
  ASIGNADO
  EN_CURSO
  FINALIZADO
  CANCELADO
}
enum FitnessStatus {
  APTO
  RESTRINGIDO
  NO_APTO
  PENDIENTE
}
enum ApprovalStatus {
  PENDIENTE
  VALIDADO
  OBSERVADO
}

model Worker {
  id String @id @default(cuid())
  document String @unique
  name String
  job String
  area String
  secondaryArea String?
  active Boolean @default(true)
  license String?
  licenseExpires DateTime?
  entryDate DateTime?
  createdAt DateTime @default(now())
  user User?
  rosters Roster[]
  services Service[]
  timesheets Timesheet[]
  fitness MedicalFitness?
  clearances Clearance[]
  inspections Inspection[]
  enrollments Enrollment[]
  contracts Contract[]
  safetyCases SafetyCase[]
  pauses ActivePause[]
  practiceAttempts PracticeAttempt[]
  @@index([area,active])
}

model User {
  id String @id @default(cuid())
  workerId String? @unique
  ownerId String?
  owner Owner? @relation(fields:[ownerId],references:[id])
  worker Worker? @relation(fields:[workerId],references:[id])
  login String @unique
  displayName String
  passwordHash String
  role Role
  active Boolean @default(true)
  mustChangePassword Boolean @default(false)
  failedLogins Int @default(0)
  lockedUntil DateTime?
  sessions Session[]
  grants UserRoleGrant[]
  receipts Receipt[]
  audit AuditLog[]
  createdAt DateTime @default(now())
}

model UserRoleGrant {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  role Role
  grantedBy String
  grantedAt DateTime @default(now())
  revokedAt DateTime?
  @@unique([userId,role])
  @@index([userId,revokedAt])
}

model Session {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId,expiresAt])
}

model AuditLog {
  id String @id @default(cuid())
  userId String?
  user User? @relation(fields:[userId],references:[id],onDelete:SetNull)
  entity String
  entityId String
  action String
  payload Json?
  at DateTime @default(now())
  @@index([entity,entityId,at])
}

model Owner {
  id String @id @default(cuid())
  name String
  document String @unique
  contact String?
  vehicles Vehicle[]
  users User[]
}

model Vehicle {
  id String @id @default(cuid())
  code String @unique
  plate String @unique
  type String
  make String?
  model String?
  year Int?
  color String?
  vin String?
  engineNumber String?
  mineCode String?
  ownerId String?
  owner Owner? @relation(fields:[ownerId],references:[id])
  active Boolean @default(true)
  createdAt DateTime @default(now())
  documents VehicleDocument[]
  readings OdometerReading[]
  equipment VehicleEquipment[]
  checklists VehicleChecklist[]
  workOrders WorkOrder[]
  clearances Clearance[]
  custody CustodyEvent[]
  services Service[]
  cases SafetyCase[]
  inspections Inspection[]
  pauses ActivePause[]
  @@index([ownerId])
}

// Inventario vivo por unidad; no se debe confundir con el stock central de Almacén.
model VehicleEquipment {
  id String @id @default(cuid())
  vehicleId String
  vehicle Vehicle @relation(fields:[vehicleId],references:[id],onDelete:Restrict)
  itemCode String
  category String
  label String
  expectedQuantity Int
  actualQuantity Int
  condition String // CONFORME, OBSERVADO, NO_CONFORME
  functionalStatus String // OPERATIVO, NO_OPERATIVO, NO_PROBADO
  serial String?
  evidenceKey String?
  remarks String?
  updatedBy String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  @@unique([vehicleId,itemCode])
  @@index([vehicleId,category])
}

// Cada inspección genera una instantánea histórica; nunca sobrescribe otra inspección.
model VehicleChecklist {
  id String @id @default(cuid())
  vehicleId String
  vehicle Vehicle @relation(fields:[vehicleId],references:[id],onDelete:Restrict)
  clientEventId String @unique
  context String // FICHA_INICIAL o REVISION_PROGRAMADA
  templateVersion Int
  vehicleType String
  status String // CONFORME, OBSERVADO, CRITICO
  items Json
  overallEvidenceKey String?
  performedBy String
  performedAt DateTime @default(now())
  @@index([vehicleId,performedAt])
}

model VehicleDocument {
  id String @id @default(cuid())
  vehicleId String
  vehicle Vehicle @relation(fields:[vehicleId],references:[id])
  kind String
  reference String?
  expiresAt DateTime
  evidenceKey String?
  verifiedAt DateTime?
  createdAt DateTime @default(now())
  @@index([vehicleId,kind,expiresAt])
}

model OdometerReading {
  id String @id @default(cuid())
  vehicleId String
  vehicle Vehicle @relation(fields:[vehicleId],references:[id])
  kilometers Int
  evidenceKey String?
  at DateTime @default(now())
  @@index([vehicleId,at])
}

model WorkOrder {
  id String @id @default(cuid())
  vehicleId String
  vehicle Vehicle @relation(fields:[vehicleId],references:[id])
  issue String
  critical Boolean @default(false)
  status WorkStatus @default(ABIERTA)
  openedAt DateTime @default(now())
  releasedAt DateTime?
  releasedBy String?
  evidenceKey String?
  @@index([vehicleId,status])
}

model Clearance {
  id String @id @default(cuid())
  workerId String?
  worker Worker? @relation(fields:[workerId],references:[id])
  vehicleId String?
  vehicle Vehicle? @relation(fields:[vehicleId],references:[id])
  kind String
  scope String @default("MINA")
  reference String?
  issuedAt DateTime?
  validUntil DateTime
  verified Boolean @default(false)
  evidenceKey String?
  createdAt DateTime @default(now())
  @@index([vehicleId,kind,validUntil])
  @@index([workerId,kind,validUntil])
}

model MedicalFitness {
  id String @id @default(cuid())
  workerId String @unique
  worker Worker @relation(fields:[workerId],references:[id])
  status FitnessStatus
  validUntil DateTime
  reviewedBy String
  reviewedAt DateTime @default(now())
  // No se guarda historia clínica ni diagnóstico en esta tabla.
}

model Roster {
  id String @id @default(cuid())
  workerId String
  worker Worker @relation(fields:[workerId],references:[id])
  kind RosterKind
  startsAt DateTime
  endsAt DateTime
  status RosterStatus @default(BORRADOR)
  createdBy String
  publishedBy String?
  publishedAt DateTime?
  version Int @default(1)
  createdAt DateTime @default(now())
  @@index([workerId,startsAt,endsAt])
}

model Service {
  id String @id @default(cuid())
  code String @unique
  customer String
  route String
  startsAt DateTime
  endsAt DateTime
  mineRequired Boolean @default(false)
  mineScope String?
  workerId String?
  worker Worker? @relation(fields:[workerId],references:[id])
  vehicleId String?
  vehicle Vehicle? @relation(fields:[vehicleId],references:[id])
  status ServiceStatus @default(PLANIFICADO)
  startedAt DateTime?
  endedAt DateTime?
  createdAt DateTime @default(now())
  events ServiceEvent[]
  inspections Inspection[]
  timesheets Timesheet[]
  pauses ActivePause[]
  @@index([workerId,startsAt,endsAt])
  @@index([vehicleId,startsAt,endsAt])
}

model ServiceEvent {
  id String @id @default(cuid())
  serviceId String
  service Service @relation(fields:[serviceId],references:[id])
  clientEventId String @unique
  type String
  description String?
  occurredAt DateTime
  receivedAt DateTime @default(now())
  @@index([serviceId,occurredAt])
}

model Inspection {
  id String @id @default(cuid())
  serviceId String?
  service Service? @relation(fields:[serviceId],references:[id])
  templateVersion Int?
  clientEventId String @unique
  workerId String
  worker Worker @relation(fields:[workerId],references:[id])
  vehicleId String
  vehicle Vehicle @relation(fields:[vehicleId],references:[id])
  result String
  checklist Json
  kilometers Int?
  evidenceKey String?
  occurredAt DateTime
  receivedAt DateTime @default(now())
}

model Timesheet {
  id String @id @default(cuid())
  workerId String
  worker Worker @relation(fields:[workerId],references:[id])
  serviceId String?
  service Service? @relation(fields:[serviceId],references:[id])
  startsAt DateTime
  endsAt DateTime
  hours Float
  status ApprovalStatus @default(PENDIENTE)
  source String
  // Área al momento de registrar; null en tareos anteriores a esta migración.
  areaAtEntry String?
  reason String?
  reviewerId String?
  createdAt DateTime @default(now())
  @@index([workerId,startsAt,endsAt])
}

model SafetyCase {
  id String @id @default(cuid())
  reference String @unique
  category String
  severity String
  title String
  details String
  status CaseStatus @default(ABIERTO)
  workerId String?
  worker Worker? @relation(fields:[workerId],references:[id])
  vehicleId String?
  vehicle Vehicle? @relation(fields:[vehicleId],references:[id])
  evidenceKey String?
  closureReason String?
  closedBy String?
  closedAt DateTime?
  createdAt DateTime @default(now())
  actions SafetyAction[]
  @@index([vehicleId,status])
}

model SafetyAction {
  id String @id @default(cuid())
  caseId String
  safetyCase SafetyCase @relation(fields:[caseId],references:[id])
  description String
  responsible String
  dueAt DateTime
  status ActionStatus @default(PENDIENTE)
  evidenceKey String?
  verifiedBy String?
  verifiedAt DateTime?
}

model Contract {
  id String @id @default(cuid())
  workerId String
  worker Worker @relation(fields:[workerId],references:[id])
  kind String
  startsAt DateTime
  endsAt DateTime?
  evidenceKey String?
  createdAt DateTime @default(now())
}

model Course {
  id String @id @default(cuid())
  title String
  area String @default("SSOMA")
  description String
  version Int @default(1)
  hours Float
  passingScore Int @default(80)
  maxAttempts Int @default(2)
  modality TrainingModality @default(PRESENCIAL)
  minVirtualMinutes Int @default(5)
  published Boolean @default(false)
  archivedAt DateTime?
  seriesKey String?
  requireMaterial Boolean @default(false)
  requiresExam Boolean @default(true)
  materials CourseMaterial[]
  createdAt DateTime @default(now())
  questions Question[]
  enrollments Enrollment[]
}

model CourseMaterial {
  id String @id @default(cuid())
  courseId String
  course Course @relation(fields:[courseId],references:[id],onDelete:Restrict)
  title String
  content String
  createdAt DateTime @default(now())
}

model Question {
  id String @id @default(cuid())
  courseId String
  course Course @relation(fields:[courseId],references:[id],onDelete:Restrict)
  statement String
  position Int
  choices Choice[]
  @@unique([courseId,position])
}

model Choice {
  id String @id @default(cuid())
  questionId String
  question Question @relation(fields:[questionId],references:[id],onDelete:Restrict)
  text String
  correct Boolean @default(false)
}

model Enrollment {
  id String @id @default(cuid())
  courseId String
  course Course @relation(fields:[courseId],references:[id])
  workerId String
  worker Worker @relation(fields:[workerId],references:[id])
  attendedAt DateTime?
  attendanceStatus AttendanceStatus @default(PENDIENTE)
  attendanceRecordedAt DateTime?
  attendanceRecordedBy String?
  attendanceEvidenceKey String? @unique
  absenceReason String?
  virtualStartedAt DateTime?
  virtualCompletedAt DateTime?
  materialValidatedAt DateTime?
  cycle Int @default(1)
  approvedAt DateTime?
  score Int?
  certificateCode String? @unique
  attempts QuizAttempt[]
  @@unique([courseId,workerId])
}

model QuizAttempt {
  id String @id @default(cuid())
  enrollmentId String
  enrollment Enrollment @relation(fields:[enrollmentId],references:[id])
  sequence Int
  cycle Int @default(1)
  score Int
  passed Boolean
  responses Json
  createdAt DateTime @default(now())
  @@unique([enrollmentId,sequence])
}

model Announcement {
  id String @id @default(cuid())
  title String
  body String
  targetRole Role?
  version Int @default(1)
  publishedAt DateTime @default(now())
  receipts Receipt[]
  revisions AnnouncementRevision[]
}

model AnnouncementRevision {
  id String @id @default(cuid())
  announcementId String
  announcement Announcement @relation(fields:[announcementId],references:[id])
  version Int
  title String
  body String
  modifiedBy String
  at DateTime @default(now())
  @@unique([announcementId,version])
}

model Receipt {
  id String @id @default(cuid())
  announcementId String
  announcement Announcement @relation(fields:[announcementId],references:[id])
  userId String
  user User @relation(fields:[userId],references:[id])
  version Int
  at DateTime @default(now())
  @@unique([announcementId,userId,version])
}

model InventoryItem {
  id String @id @default(cuid())
  sku String @unique
  name String
  unit String
  quantity Int @default(0)
  moves StockMovement[]
}

model StockMovement {
  id String @id @default(cuid())
  itemId String
  item InventoryItem @relation(fields:[itemId],references:[id])
  delta Int
  reason String
  actorId String
  createdAt DateTime @default(now())
}

// Actas de custodia: salida y devolución independientes con inventarios históricos.
// Los campos nuevos son opcionales para preservar las actas anteriores a la Fase 02.
model CustodyEvent {
  id String @id @default(cuid())
  vehicleId String
  vehicle Vehicle @relation(fields:[vehicleId],references:[id])
  clientEventId String? @unique
  kind String
  party String
  condition String
  evidenceKey String?
  location String?
  senderName String?
  receiverName String?
  odometerKm Int?
  fuelPercent Int?
  relatedDeliveryId String?
  items CustodyInventoryLine[]
  signatures CustodySignature[]
  contentVersion Int @default(1) // v1/v2 históricos; v3 también fija evidencia general y entrega relacionada
  technicalVerifiedAt DateTime?
  technicalVerifiedBy String?
  safetyVerifiedAt DateTime?
  safetyVerifiedBy String?
  at DateTime @default(now())
  recordedBy String
  @@index([vehicleId,at])
  @@index([relatedDeliveryId])
}

// Cada evento contiene su propia instantánea inmutable: no se recalcula a partir
// del inventario vivo y una devolución no reemplaza los datos de salida.
model CustodyInventoryLine {
  id String @id @default(cuid())
  custodyEventId String
  custodyEvent CustodyEvent @relation(fields:[custodyEventId],references:[id],onDelete:Restrict)
  itemCode String
  label String
  serial String?
  expectedQuantity Int
  actualQuantity Int
  damagedQuantity Int @default(0)
  condition String
  notes String?
  discrepancy Boolean @default(false)
  resolvedAt DateTime?
  resolvedBy String?
  resolutionReason String?
  resolutionEvidenceKey String?
  photos CustodyItemPhoto[]
  @@unique([custodyEventId,itemCode])
  @@index([custodyEventId,discrepancy,resolvedAt])
}

// Evidencias fotográficas originales por elemento al registrar un acta (no reemplazables).
// Los anexos de resolución usan resolutionEvidenceKey, y no alteran esta instantánea.
model CustodyItemPhoto {
  id String @id @default(cuid())
  custodyLineId String
  custodyLine CustodyInventoryLine @relation(fields:[custodyLineId],references:[id],onDelete:Restrict)
  evidenceKey String @unique
  uploadedById String
  createdAt DateTime @default(now())
  @@index([custodyLineId,createdAt])
}

// Firma manuscrita capturada en pantalla: evidencia privada, no firma digital certificada.
// Ningún firmante puede reemplazar la firma original de su lado en la misma acta.
model CustodySignature {
  id String @id @default(cuid())
  custodyEventId String
  custodyEvent CustodyEvent @relation(fields:[custodyEventId],references:[id],onDelete:Restrict)
  side String
  signerName String
  evidenceKey String @unique
  documentHash String
  capturedById String
  witnessedInPerson Boolean @default(false)
  signedAt DateTime @default(now())
  @@unique([custodyEventId,side])
  @@index([custodyEventId,signedAt])
}

enum TrainingModality {
  PRESENCIAL
  VIRTUAL
}
enum AttendanceStatus {
  PENDIENTE
  ASISTIO
  NO_ASISTIO
  JUSTIFICADO
}
enum EvidencePurpose {
  FLOTA
  MANTENIMIENTO
  SSOMA
  HOMOLOGACION
  RRHH
  CUSTODIA
  CONNECT
  AULA
}

model EvidenceAsset {
  id String @id @default(cuid())
  key String @unique
  uploadedBy String
  filename String
  contentType String
  expectedBytes Int? // tamaño solicitado al generar URL; nulo para evidencias legadas
  purpose EvidencePurpose
  verifiedAt DateTime?
  createdAt DateTime @default(now())
  @@index([uploadedBy,createdAt])
}

// Pausas diarias: una ficha central por fecha con múltiples registros por conductor.
// Foto obligatoria para una pausa realizada; motivo para una pausa omitida.
model ActivePause {
  id String @id @default(cuid())
  clientEventId String @unique
  workerId String
  worker Worker @relation(fields:[workerId], references:[id])
  serviceId String?
  service Service? @relation(fields:[serviceId], references:[id])
  vehicleId String?
  vehicle Vehicle? @relation(fields:[vehicleId], references:[id])
  evidenceKey String? @unique
  status String // EN_CURSO, FINALIZADA, NO_REALIZADA
  plannedMinutes Int @default(5)
  startedAt DateTime?
  dueAt DateTime?
  completedAt DateTime?
  missedReason String?
  registeredBy String
  workerName String
  unitCode String?
  plate String?
  serviceCode String?
  createdAt DateTime @default(now())
  @@index([workerId,createdAt])
  @@index([serviceId,createdAt])
}

// Catálogo administrativo; no confundir áreas laborales con roles RBAC.
model WorkArea {
  name String @id
  active Boolean @default(true)
  createdAt DateTime @default(now())
}

// SIMULACROS INTERNOS: no son cursos oficiales ni generan homologaciones o certificados.
model PracticeTopicState {
  code String @id
  published Boolean @default(false)
  publishedAt DateTime?
  updatedAt DateTime @updatedAt
}

model PracticeQuestion {
  id String @id @default(cuid())
  topicCode String
  statement String
  optionA String
  optionB String
  optionC String
  optionD String
  correctOption String
  active Boolean @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([topicCode,active,createdAt])
}

model PracticeMaterial {
  id String @id @default(cuid())
  topicCode String
  title String
  content String?
  url String?
  evidenceKey String?
  vehicleType String?
  createdBy String
  createdAt DateTime @default(now())
  @@index([topicCode,createdAt])
}

model PracticeAttempt {
  id String @id @default(cuid())
  clientEventId String @unique
  topicCode String
  workerId String
  worker Worker @relation(fields:[workerId],references:[id],onDelete:Restrict)
  answers Json
  correctCount Int
  totalQuestions Int
  score Int
  createdAt DateTime @default(now())
  @@index([workerId,topicCode,createdAt])
}
