{
  "name": "kcj-control-empresarial",
  "version": "1.0.4-piloto-claves-administradas",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma generate && prisma migrate deploy && npm run db:seed",
    "db:studio": "prisma studio",
    "db:verify": "tsx scripts/verificar-bd.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run test && npm run typecheck && npm run build",
    "db:integration": "tsx scripts/prueba-integracion-postgres.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "verify:package": "node scripts/verificar-paquete.mjs",
    "db:check-login": "tsx scripts/verificar-acceso-inicial.ts",
    "db:diagnose": "node scripts/diagnostico-estructura.mjs"
  },
  "dependencies": {
    "next": "15.5.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@prisma/client": "6.19.0",
    "zod": "3.24.2",
    "@aws-sdk/client-s3": "^3.850.0",
    "@aws-sdk/s3-request-presigner": "^3.850.0",
    "server-only": "0.0.1",
    "dotenv": "^16.5.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "prisma": "6.19.0",
    "typescript": "^5.8.3",
    "tsx": "^4.19.2",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.5.3",
    "autoprefixer": "^10.4.21",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/qrcode": "^1.5.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
